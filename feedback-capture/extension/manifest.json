{
  "manifest_version": 3,
  "name": "Pinpoint",
  "version": "1.1.3",
  "description": "Select web elements and save concise reports to your local Pinbox.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "48": "pinpoint-icon-48.png",
    "96": "pinpoint-icon-96.png"
  },
  "optional_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Pinpoint: Select an element",
    "default_icon": "pinpoint-icon-96.png",
    "default_popup": "popup.html"
  },
  "commands": {
    "start-element-selection": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P",
        "windows": "Alt+Shift+P"
      },
      "description": "Select an element with Pinpoint"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pointfix-ui-feedback@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}