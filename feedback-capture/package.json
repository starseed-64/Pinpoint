{
  "name": "pinpoint",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321 --strictPort",
    "start": "node scripts/start.mjs",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/browser/*.test.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "lint:firefox": "web-ext lint --source-dir extension --warnings-as-errors",
    "name:firefox": "node scripts/name-firefox-xpi.mjs",
    "package:firefox": "node scripts/package-firefox.mjs"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "astro": "^7.4.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "jszip": "3.10.2",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "web-ext": "10.8.0"
  }
}
